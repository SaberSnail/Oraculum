<?xml version="1.0" encoding="utf-8"?>
<!--
	Where packages may come from, and how they're checked. See "Third-Party Packages" in Dependencies.md.
-->
<configuration>
	<!-- Only nuget.org, whatever other sources the machine's own settings list. -->
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>

	<!-- Every package must come from nuget.org, so a package of the same name on another source can't be used instead. -->
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>

	<!-- Every package must be signed by a trusted signer. -->
	<config>
		<add key="signatureValidationMode" value="require" />
	</config>

	<!--
		nuget.org signs every package it publishes. These are its signing certificates, as its service index listed them,
		added by running "dotnet nuget trust source nuget.org" with this file as the config file (see Dependencies.md).
		When nuget.org starts signing with a new certificate, restores fail until it's added the same way.
	-->
	<trustedSigners>
		<repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
			<certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
			<certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
			<certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
		</repository>
	</trustedSigners>
</configuration>
